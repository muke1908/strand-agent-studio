# Clone strand-workflows separately, then set this to its existing directory.
STRAND_WORKFLOWS_DIR=/absolute/path/to/strand-workflows

# Every agent shares read/write access to these existing directories.
# get_path accepts the suffix name, e.g. TSCALLING_WORKSPACE.
STRAND_PATH_TSCALLING_WORKSPACE=/absolute/path/to/existing/TsCalling/checkout
STRAND_PATH_WORKFLOW_DATA=/absolute/path/to/workflow-state-and-reports
STRAND_PATH_STUDIO_OUT=/absolute/path/to/studio-output
STRAND_PATH_NODE_BIN=/absolute/path/to/node/bin

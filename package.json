{
  "name": "strand-agent-studio",
  "private": true,
  "type": "module",
  "description": "An agent-first workflow studio with durable runs and policy-driven watches.",
  "engines": {
    "node": ">=24.13"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/main.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/server/main.js",
    "workflows:refresh": "node --env-file-if-exists=.env server/workflow-import.ts --refresh",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "^12.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cron-parser": "^5.4.0",
    "cross-spawn": "^7.0.6",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  }
}
